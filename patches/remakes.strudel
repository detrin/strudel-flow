// @name Remakes: 2 GIRLS and starstruck
// @author detrin
// @description Sounds remade from reference tracks with the match-sound skill: the gated, hard-tuned vocal intro and the 0:18 glitch of 2 GIRLS (muted), and the first 10 seconds of starstruck, including the 808's high whine.
// 2 GIRLS (Earth To Emily): gated vocal intro and the 0:18 glitch, muted

setcpm(146/4)
const VOX = "[63@8 ~@8] [63@9 ~@7] [63@8 65@3 ~@5] [63@8 65@4 67@4 63@8 ~@8]@2 [63@8 ~@8] [63@8 67@3 ~@5] [63@8 65@4 67@2 65@2 63@8 ~@8]@2 [63@8 ~@8] [63@8 65@3 ~@5] [63@8 65@4 67@4 63@8 ~@8]@2 [63@8 ~@8] [63@8 67@4 63@4] [63 63 63 63 65 65 67 65]"
const HARM = [1, 1, 0.56, 0.06, 0.06, 0.32, 0.4, 0.14, 0.14, 0.09, 0.11, 0.11, 0.06, 0.04, 0.045, 0.05]
// starstruck (prod. geam): first 10 s, 6 bars
const MEL = "[74@7 ~@9 76@3 ~ 78@3 ~ 81@8 76@3 ~ 78@3 ~ 76@7 ~ 74@7 ~@9] [76@3 ~@5 76@3 ~@5 76@3 ~ 76@3 ~ 76@7 ~ 76@3 ~ 78@3 ~ 76@7 ~ 74@7 ~ 69@7 ~]"
const LEAD = [1, 0.4, 0.4, 0.32, 0.47, 0.21, 0.13, 0.06, 0.19, 0.1, 0.11, 0.11, 0.053, 0.056, 0.042, 0.06, 0.032, 0.028, 0.03, 0.033]
const BASS = "[23@6 26@6 31@6 ~@2 31@6 30@6]"
const WHINE = "[~@20 31@6 30@6]"
// @frame -60,-60,3080,1180 "2 GIRLS (muted)"
// @frame -60,1180,2200,1030 "starstruck melody"
// @frame -60,2270,2440,1420 "starstruck bass"
// @frame -60,3730,1760,1900 "starstruck drums"

// @layout 0,0 390,0 716,0 1036,0 1362,0 1688,0 2014,0
_vox: stack(...HARM.map((g, i) => note(VOX).add(note(12 * Math.log2(i + 1))).gain(g)))
  .slow(4)
  .sound("sine")
  .attack(0.004).decay(0.3).sustain(0.35).release(0.025)
  .room(0.25)
  .postgain(0.35)
  .mask("<1!4 0!32>")

// @layout 0,570 390,570 710,570 1036,570 1362,570 1688,570 2014,570 2340,570 2666,570
_glitch: note(81.25)
  .sound("sawtooth")
  .struct("x*32").degradeBy(0.45)
  .sometimesBy(0.3, x => x.ply(2))
  .gain("<0!12 0.3 0.12!6 0 0.32!16>").pan(rand)
  .crush(6).coarse(3)
  .hpf(9000)
  .attack(0.002).decay(0.03).sustain(0).release(0.01)
  .mask("<0!12 1!7 0 1!16>")

// @layout 0,1220 390,1220 716,1220 1026,1220 1352,1220 1678,1220
lead: stack(...LEAD.map((g, i) => note(MEL).add(note(12 * Math.log2(i + 1))).gain(g)))
  .slow(2)
  .sound("sine")
  .attack(0.005).release(0.02)
  .postgain(0.6)
  .mask("<1 [1@14 0@2] 1 1 1 1>")

// @layout 0,1725 477,1725 787,1725 1113,1725 1439,1725 1765,1725
counter: note("[66@2 ~ 69 ~ 66 [55,62]@2] [~ [55,62]@2 ~ 62 61 ~@2]")
  .sound("sawtooth")
  .slow(2)
  .attack(0.04).release(0.05)
  .gain(0.6)
  .mask("<1!6>")

// @layout 0,2311 390,2311 716,2311 1026,2311 1352,2311 1678,2311 2004,2311
sub: note(BASS)
  .slow(2)
  .sound("sine")
  .shape(0.35)
  .attack(0.004).release(0.03)
  .gain(2)
  .mask("<0!2 1!4>")

// @layout 0,2816 390,2816 716,2816 1026,2816 1352,2816 1678,2816
whine: stack(...[[290, 0.5], [291, 1], [292, 0.5]].map(([k, g]) => note(WHINE).add(note(12 * Math.log2(k))).gain(g)))
  .slow(2)
  .sound("sine")
  .attack(0.005).release(0.02)
  .postgain(0.08)
  .mask("<0!3 1 0 1>")

// @layout 0,3321 326,3321 652,3321 978,3321 1304,3321
kick: s("[bd ~@5 bd ~@5 bd ~@7 bd ~@11]")
  .bank("RolandTR808")
  .slow(2)
  .gain(3.5)
  .mask("<0!2 1!4>")

// @layout 0,3765 326,3765 652,3765 978,3765
snare: s("~ ~ sd ~")
  .bank("RolandTR909")
  .gain(0.6)
  .mask("<0!2 1!4>")

// @layout 0,4129 326,4129 652,4129 652,4502 978,4129
hats: s("<[hh hh hh ~]*4 [[hh hh hh ~] [hh hh hh [~ hh]] [hh hh hh ~] [hh hh hh ~]]>")
  .bank("RolandTR808")
  .speed(0.8)
  .gain(2).postgain(1.2)
  .mask("<0!2 1!4>")

// @layout 0,4866 326,4866 652,4866 652,5239 978,4866 1304,4866
roll: s("<~ [~ [~@6 hh ~] [~@5 hh hh hh] [~@3 hh ~ hh hh hh]]>")
  .bank("RolandTR808")
  .speed(1.5)
  .hpf(10000)
  .gain(1.5)
  .mask("<0!2 1!4>")
