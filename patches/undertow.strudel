// @name Undertow (flow edition)
// @author detrin
// @description Acid techno in 64 bars: 909 drums, an acid line with a filter envelope, LFOs, dub stabs and a riser. Each line's Arrange node is its part of the song.

setcpm(132/4)

// @layout 0,0 390,0 390,211 716,0 1042,0
kick: n("0*4")
  .sound("bd")
  .bank("RolandTR909")
  .gain(1)
  .mask("<1!32 0!8 1!24>")

// @layout 0,420 477,420 761,420 761,652 1087,420 1413,420
rumble: note("<c1 c1 eb1 g0>*8")
  .sound("sine")
  .lpf(140)
  .gain(0.55)
  .delay(0.3).delaytime(0.1875).delayfeedback(0.4)
  .mask("<0!4 1!28 0!8 1!16 0!8>")

// @layout 0,926 326,926 652,926 978,926 1304,926 1630,926
hats: s("[~ hh]*4")
  .bank("RolandTR909")
  .degradeBy(0.15)
  .gain(0.45).pan(sine.range(0.3, 0.7).slow(4))
  .hpf(6000)
  .mask("<0!4 1!28 0!8 1!24>")

// @layout 0,1346 326,1346 652,1346 978,1346 1304,1346 1630,1346
clap: s("~ cp")
  .bank("RolandTR909")
  .late(0.01)
  .speed(0.95)
  .room(0.25)
  .mask("<0!8 1!24 0!8 1!16 0!8>")

// @layout 0,1766 477,1766 761,1766 1087,1766 1413,1766 1413,1998 1739,1766 1739,2118 2097,1766
acid: note("c2 c2 [c3 c2] eb2 c2 g1 c2 bb1")
  .sound("sawtooth")
  .gain(perlin.range(0.6, 0.85))
  .lpf(500).lpq(14).lpenv(3).lpattack(0.001).lpdecay(0.12).lpsustain(0.001).lprelease(0.01)
  .distort(0.6)
  .delay(0.25).delaytime(0.375)
  .analyze("acid")
  ._punchcard()
  .mask("<0!12 1!20 0!4 1!20 0!8>")

// @layout 0,2416 390,2416 674,2416 1000,2416 1326,2416 1652,2416 1978,2416 2304,2416 2630,2416
pad: n("<[0,2,4,6] [5,7,9,11]>/2")
  .sound("supersaw")
  .scale("C3:minor")
  .unison(7).detune(0.3)
  .attack(0.5).decay(0.5).sustain(0.6).release(1.5)
  .phaser(0.5).phaserdepth(0.6)
  .room(0.6).rsize(6)
  .orbit(2)
  .mask("<0!32 1!8 0!16 1!8>")

// @layout 0,2836 477,2836 761,2836 1087,2836 1087,3068 1413,2836
stab: note("~ [c4,eb4,g4] ~ ~")
  .sound("square")
  .sometimes(x => x.trans(12))
  .hpf(400)
  .delay(0.5).delaytime(0.1875).delayfeedback(0.6)
  .mask("<0!16 1!16 0!8 1!16 0!8>")

// @layout 0,3336 326,3336 652,3336 978,3336
riser: s("white*16")
  .hpf(saw.range(500, 8000).slow(2))
  .gain(0.25)
  .mask("<0!14 1!2 0!22 1!2 0!24>")

// @layout 0,3756 326,3756 652,3756 652,3988 978,3756
breaks: s("breaks165")
  .loopAt(2).chop(8)
  .hpf(800)
  .gain(0.4)
  .mask("<0!24 1!8 0!8 1!16 0!8>")
