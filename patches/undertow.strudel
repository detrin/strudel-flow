// @name Undertow (flow edition)
// @author detrin
// @description Acid techno in 64 bars: 909 drums, an acid line with a filter envelope, LFOs, dub stabs and a riser. Each line's Arrange node is its part of the song.

setcpm(132/4)

// @layout 0,0 390,0 390,211 716,0 1042,0 1042,469 1368,0
kick: n("0*4")
  .sound("bd")
  .bank("RolandTR909")
  .penv(4).pdecay(0.05)
  .gain(1)
  .duck(2).duckdepth(0.6)
  .mask("<1!32 0!8 1!24>")

// @layout 0,802 477,802 787,802 1113,802 1439,802 1765,802
rumble: note("<c1 c1 eb1 g0>*8")
  .sound("sine")
  .lpf(140)
  .gain(0.55)
  .delay(0.3).delaytime(0.1875).delayfeedback(0.4)
  .mask("<0!4 1!28 0!8 1!16 0!8>")

// @layout 0,1308 326,1308 652,1308 978,1308 1304,1308 1630,1308 1956,1308
hats: s("[~ hh]*4")
  .bank("RolandTR909")
  .degradeBy(0.15)
  .jux(rev)
  .gain(0.45).pan(sine.range(0.3, 0.7).slow(4))
  .hpf(6000)
  .mask("<0!4 1!28 0!8 1!24>")

// @layout 0,1813 326,1813 652,1813 978,1813 1304,1813 1630,1813
clap: s("~ cp")
  .bank("RolandTR909")
  .late(0.01)
  .speed(0.95)
  .room(0.25)
  .mask("<0!8 1!24 0!8 1!16 0!8>")

// @layout 0,2318 477,2318 787,2318 1113,2318 1439,2318 1439,2691 1765,2318 1765,2670 2123,2318
acid: note("c2 c2 [c3 c2] eb2 c2 g1 c2 bb1")
  .sound("sawtooth")
  .gain(perlin.range(0.6, 0.85))
  .lpf(500).lpq(14).lpenv(3).lpattack(0.001).lpdecay(0.12).lpsustain(0.001).lprelease(0.01)
  .distort(0.6)
  .delay(0.25).delaytime(0.375)
  .analyze("acid")
  ._punchcard()
  .mask("<0!12 1!20 0!4 1!20 0!8>")

// @layout 0,3055 390,3055 700,3055 1026,3055 1026,3287 1352,3055 1352,3287 1678,3055 2004,3055
pad: n("<[0,2,4,6] [5,7,9,11]>/2")
  .sound("supersaw")
  .scale("C3:minor")
  .unison(7).detune(0.3)
  .attack(0.5).decay(0.5).sustain(0.6).release(1.5)
  .phaser(0.5).phaserdepth(0.6)
  .room(0.6).rsize(6)
  .orbit(2)
  .mask("<0!32 1!8 0!16 1!8>")

// @layout 0,3792 477,3792 787,3792 1113,3792 1113,4024 1439,3792 1765,3792
stab: note("~ [c4,eb4,g4] ~ ~")
  .sound("square")
  .sometimes(x => x.trans(12))
  .fm(1.5).fmh(2)
  .hpf(400)
  .delay(0.5).delaytime(0.1875).delayfeedback(0.6)
  .mask("<0!16 1!16 0!8 1!16 0!8>")

// @layout 0,4388 326,4388 652,4388 978,4388 1368,4388
riser: s("white*16")
  .hpf(saw.range(500, 8000).slow(2))
  .gain(0.25)
  ._spectrum()
  .mask("<0!14 1!2 0!22 1!2 0!24>")

// @layout 0,4893 326,4893 652,4893 978,4893 1304,4893
breaks: s("breaks165")
  .loopAt(2).chop(8)
  .hpf(800)
  .gain(0.4)
  .mask("<0!24 1!8 0!8 1!16 0!8>")
